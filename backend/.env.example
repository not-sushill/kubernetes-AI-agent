APP_NAME=AI Kubernetes Troubleshooting Agent
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
API_PREFIX=/api
# Leave DATABASE_URL unset to use backend/ai_kubernetes_agent.db.
# Keep the DATABASE_URL in your existing .env when upgrading.
AI_DIAGNOSIS_ENABLED=true
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Optional Operations integrations. Empty values keep these integrations disabled.
LOKI_URL=
LOKI_TOKEN=
LOKI_TENANT=
LOKI_LABEL_CLUSTER=cluster
LOKI_LABEL_NAMESPACE=namespace
LOKI_LABEL_POD=pod
LOKI_LABEL_CONTAINER=container
ALERT_WEBHOOK_URL=
CONSOLE_URL=http://localhost:3000
# List of {name, role, token_sha256}. Generate tokens with scripts/create-team-user.py.
TEAM_USERS_JSON=[]
# Optional custom lock-file path for the single Operations worker.
# OPERATIONS_LOCK_PATH=D:/projects/ai-kubernetes-agent/backend/.operations-worker.lock
